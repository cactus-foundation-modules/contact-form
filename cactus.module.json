{
  "name": "contact-form",
  "version": "0.1.40",
  "tablePrefix": "cf_",
  "requiresCoreVersion": "0.5.1470",
  "emailTemplates": {
    "groupLabel": "Contact form",
    "import": "./lib/email-templates",
    "export": "contactFormEmailTemplates"
  },
  "description": "A contact form that can be placed on any page via the Puck page builder, with per-form settings and an admin inbox.",
  "permissions": [
    "contact.view",
    "contact.reply",
    "contact.delete",
    "contact.export"
  ],
  "extensionPoints": [
    {
      "point": "core.inbox-tabs",
      "id": "contact-form",
      "label": "Contact form",
      "order": 10,
      "permission": "contact.view",
      "import": "./components/admin/InboxPanel",
      "component": "ContactFormInboxPanel"
    },
    {
      "point": "core.conversation-provider",
      "id": "contact-form",
      "label": "Contact form",
      "permission": "contact.view",
      "serverOnly": true,
      "import": "./lib/conversation-provider",
      "component": "contactFormConversationProvider"
    }
  ],
  "requiredEnvVars": [],
  "cookieCategories": [],
  "teardown": ["ContactSubmission", "ContactSubmissionReply"],
  "cronJobs": [
    { "path": "/api/m/contact-form/cron/retention", "schedule": "0 3 * * *" }
  ],
  "puckBlocks": [
    {
      "type": "ContactForm",
      "import": "./components/puck/ContactFormBlock",
      "component": "contactFormPuckComponent",
      "rscComponent": "contactFormPuckRscComponent"
    }
  ]
}
